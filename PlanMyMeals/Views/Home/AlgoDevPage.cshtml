@model AlgoViewModel


<div class="container">

    <div class="row bg-secondary border m-1">

        <div class="col-sm flex">
            <h4 class="me-2">Cals: @Model.thisUser.CalorieGoal</h4>
            <h4 class="me-2">Protein: @Model.thisUser.CalorieGoal%</h4>
            <h4 class="me-2">Carbs: @Model.thisUser.CalorieGoal%</h4>
            <h4 class="me-2">Fat: @Model.thisUser.CalorieGoal%</h4>
        </div>
        <div class="col-sm">
            One of three columns
        </div>

    </div>    
    
    <div class="row bg-secondary border m-1">
        <div class="col-sm">
            One of three columns
        </div>
        <div class="col-sm">
            <ul>
                @foreach(Meal meal in Model.allMeals) {
                <li>
                    <form asp-action="Recipes" asp-controller="Home" method="post" class="flex search-QSA">
                        <input type="hidden" name="mealId" value="@meal.MealId" />
                        <button type="submit" class="btn-primary" onclick="//build recipe pg">@meal.Name</button>
                    </form>

                </li>
                }


            </ul>
        </div>

    </div>


</div>