@model RecipeViewModel


<h1 class="AddRecipeText mb-4">Add Meal Info</h1>


<div class="MealPlanContainer">


    <form asp-action="CreateMeal" asp-controller="Home" method="post" class="">


        <div class="mb-3 card card-body bg-color5">
            <div class="">
                <label class="form-label" asp-for="thisMeal.Name">Name</label>
                <input class="form-control" asp-for="thisMeal.Name">
                <span asp-validation-for="thisMeal.Name"></span>
            </div>
            <div class="">
                <label class="form-label" asp-for="thisMeal.Instructions">Instructions</label>
                <input class="form-control" asp-for="thisMeal.Instructions">
                <span asp-validation-for="thisMeal.Instructions"></span>
            </div>

            <input type="submit" class="btn btn-primary mt-4" value="Add Meal" />


        </div>

    </form>



    <div class="mb-3 card card-body bg-color2">
        <h3>Meal search:</h3>

        <div class="mb-3">
            <input class="form-control" id="mealSearch" oninput="ingSearch()" placeholder="Search..." />
        </div>



        <div class="card card-body bg-color3 MealSearchButtonBox">
            @foreach(Meal meal in Model.allMeals) {

            <form asp-action="Recipes" asp-controller="Home" method="post" class="flex search-QSA">
                <input type="hidden" name="mealId" value="@meal.MealId" />
                <button type="submit" class="btn btn-success m-2" onclick="//build recipe pg">@meal.Name</button>
            </form>

                }


        </div>


    </div>


</div>





<script>
    function mealSearch() {
        var input = document.getElementById("mealSearch").value.toLowerCase();
        var ingredients = document.querySelectorAll('.search-QSA'); //gets all elements with matching CSS tag

        ingredients.forEach(function (item) {
            var ingName = item.getAttribute('data-name').toLowerCase();
            if (ingName.startsWith(input)) {
                item.style.display = 'list-item'; //show item
            }
            else {
                item.style.display = 'none'; //hides item
                console.log("hiding item " + ingName);
            }
        });
    }


</script>